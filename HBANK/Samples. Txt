INSERT INTO ${TARGET_DATASET}.CLAIMS
(
    INSTANCE_ID,
    DATE_CASE_RECEIVED,
    BRAND,
    CIN,
    ENTITY,
    ACCOUNT_NUMBER,
    RETAILER,
    TOTAL_TRANSACTION_VALUE,
    CUSTOMER_NAME,
    CLAIM_STATUS,
    AMOUNT_CLAIMED,
    AMOUNT_SAVED_CHBK,
    AMOUNT_SAVED_RE_VIA_COURT,
    AMOUNT_SAVED_RES_WITH_RETAILER,
    ARCHIVED,
    BUSINESS_AREA_AT_FAULT,
    CASE_COMPLETE_BY,
    CATEGORY_NAME,
    COMPLETE,
    CONSEQUENTIAL_LOSS,
    COURT_CASE,
    DATE_CASE_COMPLETE,
    DATE_OF_OFFER,
    FOS_CASE,
    LEGAL_REFERRAL,
    NOTES,
    PRODUCT,
    REASON_FOR_CLAIM,
    REASON_FOR_REJECTION,
    SOURCE_OF_THE_CLAIM,
    TOTAL_OFFERED_AMOUNT,
    TOTAL_WRITTEN_OFF,
    TRANSACTION_VALUE_ON_CARD,
    WRITE_OFF_CATEGORY,
    WRITE_OFF_NUMBER,
    STATUS_CODE,
    MODIFIED_ON,
    MODIFIED_BY,
    GCP_LOAD_DATETIME,
    PRM_LNE_OF_BUS_CDE_FILTER,
    ENTITY_CDE_FILTER,
    CTRY_CDE_FILTER,
    LAST_INGESTION_TIMESTAMP
)

SELECT
    LTRIM(RTRIM(INSTANCE_ID)),
    PARSE_DATE(DATEFORMAT, LTRIM(RTRIM(DATE_CASE_RECEIVED))),
    LTRIM(RTRIM(BRAND)),
    LTRIM(RTRIM(CIN)),
    LTRIM(RTRIM(ENTITY)),
    LTRIM(RTRIM(ACCOUNT_NUMBER)),
    LTRIM(RTRIM(RETAILER)),
    CAST(REGEXP_REPLACE(LTRIM(RTRIM(TOTAL_TRANSACTION_VALUE)), r',', '') AS NUMERIC),
    LTRIM(RTRIM(CUSTOMER_NAME)),
    LTRIM(RTRIM(CLAIM_STATUS)),
    CAST(REGEXP_REPLACE(LTRIM(RTRIM(AMOUNT_CLAIMED)), r',', '') AS NUMERIC),
    CAST(REGEXP_REPLACE(LTRIM(RTRIM(AMOUNT_SAVED_CHBK)), r',', '') AS NUMERIC),
    CAST(REGEXP_REPLACE(LTRIM(RTRIM(AMOUNT_SAVED_RE_VIA_COURT)), r',', '') AS NUMERIC),
    CAST(REGEXP_REPLACE(LTRIM(RTRIM(AMOUNT_SAVED_RES_WITH_RETAILER)), r',', '') AS NUMERIC),
    CAST(LTRIM(RTRIM(ARCHIVED)) AS BOOL),
    CAST(LTRIM(RTRIM(BUSINESS_AREA_AT_FAULT)) AS BOOL),
    LTRIM(RTRIM(CASE_COMPLETE_BY)),
    LTRIM(RTRIM(CATEGORY_NAME)),
    CAST(LTRIM(RTRIM(COMPLETE)) AS BOOL),
    CAST(REGEXP_REPLACE(LTRIM(RTRIM(CONSEQUENTIAL_LOSS)), r',', '') AS NUMERIC),
    CAST(LTRIM(RTRIM(COURT_CASE)) AS BOOL),
    CAST(LTRIM(RTRIM(DATE_CASE_COMPLETE)) AS DATETIME),
    CAST(LTRIM(RTRIM(DATE_OF_OFFER)) AS DATETIME),
    CAST(LTRIM(RTRIM(FOS_CASE)) AS BOOL),
    CAST(LTRIM(RTRIM(LEGAL_REFERRAL)) AS BOOL),
    LTRIM(RTRIM(NOTES)),
    LTRIM(RTRIM(PRODUCT)),
    LTRIM(RTRIM(REASON_FOR_CLAIM)),
    LTRIM(RTRIM(REASON_FOR_REJECTION)),
    CAST(LTRIM(RTRIM(SOURCE_OF_THE_CLAIM)) AS NUMERIC),
    CAST(REGEXP_REPLACE(LTRIM(RTRIM(TOTAL_OFFERED_AMOUNT)), r',', '') AS NUMERIC),
    CAST(LTRIM(RTRIM(TOTAL_WRITTEN_OFF)) AS NUMERIC),
    CAST(LTRIM(RTRIM(TRANSACTION_VALUE_ON_CARD)) AS NUMERIC),
    LTRIM(RTRIM(WRITE_OFF_CATEGORY)),
    LTRIM(RTRIM(WRITE_OFF_NUMBER)),
    LTRIM(RTRIM(STATUS_CODE)),
    CAST(LTRIM(RTRIM(MODIFIED_ON)) AS DATETIME),
    LTRIM(RTRIM(MODIFIED_BY)),
    CAST(LTRIM(RTRIM(GCP_LOAD_DATETIME)) AS DATETIME),
    PRM_LNE_OF_BUS_CDE_FILTER,
    ENTITY_CDE_FILTER,
    CTRY_CDE_FILTER,
    LAST_INGESTION_TIMESTAMP

FROM ${STAGING_DATASET}.CLAIMS
WHERE PRM_LNE_OF_BUS_CDE_FILTER IS NOT NULL;
